<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Upper-Intermediate: Level Two — Complete Mastery Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              900: '#312e81',
            }
          }
        }
      }
    };
  </script>
  <style>
    /* 3D Flashcard Flip Animation */
    .perspective-1000 { perspective: 1000px; }
    .transform-style-3d { transform-style: preserve-3d; }
    .backface-hidden { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }
    .card-inner { transition: transform 0.55s cubic-bezier(0.4, 0.2, 0.2, 1); }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.4); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(100, 116, 139, 0.6); }

    /* Highlighted Story Terms */
    .story-term {
      border-bottom: 2px dashed #6366f1;
      background-color: rgba(99, 102, 241, 0.08);
      padding: 0 3px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.15s ease;
    }
    .story-term:hover {
      background-color: rgba(99, 102, 241, 0.22);
    }
    .dark .story-term {
      background-color: rgba(129, 140, 248, 0.15);
      border-bottom-color: #818cf8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col transition-colors duration-200">

  <!-- TOP HEADER & PROGRESS BAR -->
  <header class="sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 text-white flex items-center justify-center font-extrabold text-lg shadow-md">
          U2
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold tracking-tight leading-tight">Upper-Intermediate: Level Two</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400">Complete Course Review &amp; Consolidation (Days 1–18)</p>
        </div>
      </div>

      <!-- Overall Mastery & Theme Controls -->
      <div class="flex items-center gap-3 sm:gap-5">
        <div class="hidden sm:flex flex-col items-end">
          <div class="flex items-center gap-2 text-xs font-semibold">
            <span class="text-slate-500 dark:text-slate-400">Overall Mastery:</span>
            <span id="overall-percent" class="text-indigo-600 dark:text-indigo-400 font-bold">0%</span>
          </div>
          <div class="w-36 h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden mt-1">
            <div id="overall-bar" class="h-full bg-gradient-to-r from-indigo-500 to-emerald-500 transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <button id="reset-progress-btn" title="Reset All Saved Progress" class="p-2.5 rounded-xl text-xs font-medium bg-slate-100 hover:bg-rose-100 text-slate-600 hover:text-rose-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-rose-950/60 dark:hover:text-rose-400 transition">
          Reset
        </button>

        <button id="theme-toggle" title="Toggle Dark/Light Theme" class="p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition">
          <span id="theme-icon">🌙</span>
        </button>
      </div>
    </div>

    <!-- MAIN 4 NAVIGATION TABS -->
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-1 sm:gap-2 overflow-x-auto pb-0 border-t border-slate-100 dark:border-slate-800/60">
      <button data-tab="vocab" class="main-tab-btn flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 border-indigo-600 text-indigo-600 dark:text-indigo-400 whitespace-nowrap transition">
        <span>🗂️</span>
        <span>1. Vocabulary &amp; Cards</span>
        <span id="badge-vocab" class="text-xs px-2 py-0.5 rounded-full bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300">0/0</span>
      </button>
      <button data-tab="quizzes" class="main-tab-btn flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 whitespace-nowrap transition">
        <span>🎯</span>
        <span>2. Lexis Quizzes</span>
        <span id="badge-quizzes" class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">0 pts</span>
      </button>
      <button data-tab="stories" class="main-tab-btn flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 whitespace-nowrap transition">
        <span>📖</span>
        <span>3. Reading Stories</span>
        <span id="badge-stories" class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">0/4</span>
      </button>
      <button data-tab="grammar" class="main-tab-btn flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 whitespace-nowrap transition">
        <span>🧩</span>
        <span>4. Grammar Lab (14 Topics)</span>
        <span id="badge-grammar" class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">0/140</span>
      </button>
    </nav>
  </header>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- =========================================================
         TAB 1: VOCABULARY TRAINER (FLASHCARDS + MATCHING GAME)
         ========================================================= -->
    <section id="tab-vocab" class="tab-panel space-y-6">
      <!-- Topic Selector Pills -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 shadow-sm border border-slate-200 dark:border-slate-800">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Select Topic (Days 1–18)</h2>
          <div class="flex items-center gap-2">
            <button id="vocab-mode-cards" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-sm transition">
              🃏 3D Flashcards
            </button>
            <button id="vocab-mode-match" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
              ⚡ Matching Game
            </button>
            <button id="vocab-mode-list" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
              📋 Full Glossary
            </button>
          </div>
        </div>
        <div id="vocab-topic-pills" class="flex flex-wrap gap-1.5"></div>
      </div>

      <!-- SUB-VIEW 1A: 3D FLASHCARDS -->
      <div id="vocab-cards-view" class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3 bg-white dark:bg-slate-900 px-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-800">
          <div class="flex items-center gap-3 text-sm">
            <span id="card-counter" class="font-bold text-indigo-600 dark:text-indigo-400">Card 1 of 10</span>
            <span id="topic-mastery-label" class="text-xs px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-medium">0 learned</span>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <label class="inline-flex items-center gap-2 text-xs font-medium cursor-pointer select-none px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800">
              <input type="checkbox" id="unlearned-only-toggle" class="rounded text-indigo-600 focus:ring-indigo-500" />
              <span>Unlearned only</span>
            </label>
            <button id="shuffle-cards-btn" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition">
              🔀 Shuffle
            </button>
          </div>
        </div>

        <!-- Flashcard Stage -->
        <div class="max-w-2xl mx-auto">
          <div id="flashcard-wrapper" class="perspective-1000 h-80 sm:h-96 cursor-pointer select-none">
            <div id="flashcard-inner" class="card-inner relative w-full h-full transform-style-3d">
              <!-- FRONT -->
              <div class="backface-hidden absolute inset-0 bg-white dark:bg-slate-900 rounded-3xl shadow-lg border-2 border-slate-200 dark:border-slate-800 p-6 sm:p-10 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                  <span id="card-front-topic" class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-300">Topic</span>
                  <span id="card-status-pill" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300">Still Learning</span>
                </div>
                <div class="text-center my-auto space-y-3">
                  <h3 id="card-front-word" class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">Word</h3>
                  <p id="card-front-example" class="text-sm sm:text-base text-slate-500 dark:text-slate-400 italic max-w-lg mx-auto">"Example sentence goes here."</p>
                </div>
                <div class="text-center text-xs text-slate-400 font-medium">
                  Click card or press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700">Space</kbd> to flip ↻
                </div>
              </div>

              <!-- BACK -->
              <div class="backface-hidden rotate-y-180 absolute inset-0 bg-gradient-to-br from-indigo-600 to-violet-700 text-white rounded-3xl shadow-lg p-6 sm:p-10 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-white/15">Translation &amp; Meaning</span>
                  <span id="card-back-day" class="text-xs font-semibold opacity-80">Day 1</span>
                </div>
                <div class="text-center my-auto space-y-3">
                  <h3 id="card-back-ru" class="text-2xl sm:text-3xl font-extrabold">Перевод</h3>
                  <p id="card-back-def" class="text-sm sm:text-base text-indigo-100 max-w-lg mx-auto">Definition or synonym note</p>
                </div>
                <div class="text-center text-xs text-indigo-200">
                  Click to flip back ↺
                </div>
              </div>
            </div>
          </div>

          <!-- Flashcard Controls -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-5">
            <button id="prev-card-btn" class="p-3 rounded-2xl font-semibold text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
              ← Previous
            </button>
            <button id="mark-learning-btn" class="p-3 rounded-2xl font-semibold text-sm bg-amber-50 dark:bg-amber-950/50 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300 hover:bg-amber-100 transition">
              🔄 Still Learning
            </button>
            <button id="mark-known-btn" class="p-3 rounded-2xl font-semibold text-sm bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition">
              ✅ Know It!
            </button>
            <button id="next-card-btn" class="p-3 rounded-2xl font-semibold text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
              Next →
            </button>
          </div>
        </div>
      </div>

      <!-- SUB-VIEW 1B: MATCHING MINI-GAME -->
      <div id="vocab-match-view" class="hidden space-y-4">
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
            <div>
              <h3 class="text-lg font-bold">⚡ Speed Match Challenge</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">Match each English term from the selected topic with its Russian translation or English clue.</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="text-sm font-semibold">Moves: <span id="match-moves" class="text-indigo-600 dark:text-indigo-400 font-bold">0</span></div>
              <div class="text-sm font-semibold">Time: <span id="match-timer" class="text-emerald-600 dark:text-emerald-400 font-bold">0s</span></div>
              <button id="restart-match-btn" class="px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white transition">
                New Round
              </button>
            </div>
          </div>
          <div id="match-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3"></div>
          <div id="match-victory" class="hidden mt-6 p-5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-center space-y-2">
            <h4 class="text-xl font-extrabold text-emerald-700 dark:text-emerald-300">🎉 Round Complete!</h4>
            <p id="match-victory-stats" class="text-sm text-emerald-600 dark:text-emerald-400"></p>
            <button id="play-again-match-btn" class="mt-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition">
              Play Another Round
            </button>
          </div>
        </div>
      </div>

      <!-- SUB-VIEW 1C: FULL GLOSSARY TABLE -->
      <div id="vocab-list-view" class="hidden bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-lg font-bold">📋 Topic Vocabulary &amp; Examples</h3>
          <input type="text" id="vocab-search-input" placeholder="Search English or Russian..." class="w-full sm:w-72 px-3.5 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <div id="vocab-table-container" class="divide-y divide-slate-100 dark:divide-slate-800"></div>
      </div>
    </section>

    <!-- =========================================================
         TAB 2: VOCABULARY QUIZZES & TESTS
         ========================================================= -->
    <section id="tab-quizzes" class="tab-panel hidden space-y-6">
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-bold">🎯 Vocabulary &amp; Idioms Arena</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Test your mastery across all 14 lexical sets, idioms, word formation, and US/UK equivalents.</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <select id="quiz-topic-select" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none">
              <option value="all">All Topics (Comprehensive Exam)</option>
            </select>
          </div>
        </div>

        <!-- 3 Quiz Mode Buttons -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <button data-qmode="definition" class="quiz-mode-btn p-4 rounded-2xl border-2 border-indigo-600 bg-indigo-50/70 dark:bg-indigo-950/40 text-left transition">
            <div class="font-bold text-sm text-indigo-700 dark:text-indigo-300">🔍 Definition Detective</div>
            <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">Read the English explanation or "very ___" clue and guess the exact word or idiom.</div>
          </button>
          <button data-qmode="gapfill" class="quiz-mode-btn p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-indigo-400 text-left transition">
            <div class="font-bold text-sm">✍️ Context Gap-Fill</div>
            <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">Choose the word that fits naturally into sentences using Level Two grammar.</div>
          </button>
          <button data-qmode="usuk" class="quiz-mode-btn p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-indigo-400 text-left transition">
            <div class="font-bold text-sm">🇺🇸 ⇄ 🇬🇧 US / UK Translator</div>
            <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">Convert American vocabulary into British English (and vice versa) in context.</div>
          </button>
        </div>
      </div>

      <!-- Quiz Question Card -->
      <div id="quiz-stage" class="max-w-3xl mx-auto bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-md space-y-6">
        <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          <span id="quiz-progress-label">Question 1 of 10</span>
          <span id="quiz-streak-label" class="text-amber-600 dark:text-amber-400">🔥 Streak: 0</span>
        </div>

        <div class="space-y-2">
          <span id="quiz-category-badge" class="inline-block text-xs font-semibold px-3 py-1 rounded-full bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300">Topic</span>
          <h3 id="quiz-prompt" class="text-lg sm:text-xl font-bold leading-relaxed text-slate-900 dark:text-white">Loading question...</h3>
        </div>

        <div id="quiz-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>

        <div id="quiz-feedback" class="hidden p-4 rounded-2xl text-sm"></div>

        <div class="flex items-center justify-between pt-2">
          <button id="new-quiz-set-btn" class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
            🔄 New 10-Question Set
          </button>
          <button id="next-quiz-btn" class="hidden px-6 py-2.5 rounded-xl text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition">
            Next Question →
          </button>
        </div>
      </div>
    </section>

    <!-- =========================================================
         TAB 3: READING & COMPREHENSION STORIES
         ========================================================= -->
    <section id="tab-stories" class="tab-panel hidden space-y-6">
      <!-- Story Selector Tabs -->
      <div id="story-selector-bar" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3"></div>

      <!-- Active Story + Questions Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Story Text Column -->
        <article class="lg:col-span-7 bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
              <span id="story-meta-tags" class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Grammar &amp; Lexis Focus</span>
              <h2 id="story-title" class="text-2xl font-extrabold mt-1">Story Title</h2>
            </div>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/70 px-3.5 py-2 rounded-xl">
            💡 <strong>Interactive Tip:</strong> Click any highlighted word or phrase in the story to inspect its Russian translation and definition!
          </p>
          <div id="story-body" class="space-y-4 text-base leading-relaxed text-slate-700 dark:text-slate-200"></div>
        </article>

        <!-- Comprehension Questions Column -->
        <div class="lg:col-span-5 bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm space-y-5">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
            <h3 class="text-lg font-bold">📝 Comprehension Check</h3>
            <span id="story-score-badge" class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300">0 / 6</span>
          </div>
          <div id="story-questions-list" class="space-y-5"></div>
          <button id="check-story-btn" class="w-full py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-sm transition">
            Check My Answers
          </button>
        </div>
      </div>
    </section>

    <!-- =========================================================
         TAB 4: GRAMMAR LAB (14 SUB-TOPICS, 10 EXERCISES EACH = 140)
         ========================================================= -->
    <section id="tab-grammar" class="tab-panel hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Left Sub-Tabs Menu (14 Grammar Topics) -->
        <aside class="lg:col-span-4 bg-white dark:bg-slate-900 rounded-3xl p-4 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
          <div class="px-2 py-1">
            <h2 class="text-sm font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">Grammar &amp; Small Words</h2>
            <p class="text-xs text-slate-400 mt-0.5">14 topics • 10 drills each (140 total)</p>
          </div>
          <div id="grammar-subtabs-list" class="space-y-1 max-h-[65vh] overflow-y-auto pr-1"></div>
        </aside>

        <!-- Right Grammar Reference + 10 Exercises -->
