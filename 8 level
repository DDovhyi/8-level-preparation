/* ============================================================================
   5. APPLICATION STATE & PERSISTENCE (localStorage)
   ============================================================================ */
const STORAGE_KEY = 'u2_mastery_hub_v1';

const defaultState = {
  theme: 'light',
  activeTab: 'vocab',
  vocabTopic: 'all',
  vocabMode: 'cards',
  knownWords: [], // array of vocab IDs
  quizMode: 'definition',
  quizTopic: 'all',
  quizScore: 0,
  quizStreak: 0,
  activeStoryId: 'story1',
  storyScores: {}, // { story1: 6 }
  activeGrammarId: 'g1_ought',
  completedGrammar: [] // array of exercise IDs
};

let state = loadState();

function loadState() {
  try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
    return saved ? { ...defaultState, ...saved } : { ...defaultState };
  } catch (e) {
    return { ...defaultState };
  }
}

function saveState() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  } catch (e) {
    console.warn('Could not save state:', e);
  }
  updateGlobalProgressUI();
}

/* ============================================================================
   6. INITIALIZATION & THEME / NAVIGATION LOGIC
   ============================================================================ */
document.addEventListener('DOMContentLoaded', () => {
  applyTheme(state.theme);
  setupMainNavigation();
  setupThemeAndReset();
  initVocabTab();
  initQuizTab();
  initStoriesTab();
  initGrammarTab();
  switchMainTab(state.activeTab);
  updateGlobalProgressUI();
});

function applyTheme(theme) {
  const html = document.documentElement;
  const icon = document.getElementById('theme-icon');
  if (theme === 'dark') {
    html.classList.add('dark');
    icon.textContent = '☀️';
  } else {
    html.classList.remove('dark');
    icon.textContent = '🌙';
  }
}

function setupThemeAndReset() {
  document.getElementById('theme-toggle').addEventListener('click', () => {
    state.theme = state.theme === 'dark' ? 'light' : 'dark';
    applyTheme(state.theme);
    saveState();
  });

  const resetModal = document.getElementById('reset-modal');
  document.getElementById('reset-progress-btn').addEventListener('click', () => {
    resetModal.classList.remove('hidden');
  });
  document.getElementById('cancel-reset-btn').addEventListener('click', () => {
    resetModal.classList.add('hidden');
  });
  document.getElementById('confirm-reset-btn').addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    state = { ...defaultState, theme: state.theme };
    saveState();
    resetModal.classList.add('hidden');
    initVocabTab();
    initQuizTab();
    initStoriesTab();
    initGrammarTab();
  });

  document.getElementById('close-popover-btn').addEventListener('click', () => {
    document.getElementById('word-popover').classList.add('hidden');
  });
}

function setupMainNavigation() {
  document.querySelectorAll('.main-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      switchMainTab(btn.dataset.tab);
    });
  });
}

function switchMainTab(tabId) {
  state.activeTab = tabId;
  saveState();

  document.querySelectorAll('.main-tab-btn').forEach(btn => {
    const isActive = btn.dataset.tab === tabId;
    btn.classList.toggle('border-indigo-600', isActive);
    btn.classList.toggle('text-indigo-600', isActive);
    btn.classList.toggle('dark:text-indigo-400', isActive);
    btn.classList.toggle('border-transparent', !isActive);
    btn.classList.toggle('text-slate-600', !isActive);
    btn.classList.toggle('dark:text-slate-400', !isActive);
  });

  document.querySelectorAll('.tab-panel').forEach(panel => {
    panel.classList.toggle('hidden', panel.id !== `tab-${tabId}`);
  });
}

function updateGlobalProgressUI() {
  const totalWords = VOCAB_ITEMS.length;
  const knownCount = state.knownWords.length;
  document.getElementById('badge-vocab').textContent = `${knownCount}/${totalWords}`;

  document.getElementById('badge-quizzes').textContent = `${state.quizScore} pts`;

  const completedStories = Object.values(state.storyScores).filter(s => s >= 4).length;
  document.getElementById('badge-stories').textContent = `${completedStories}/${STORIES.length}`;

  const totalGrammar = GRAMMAR_TOPICS.reduce((acc, t) => acc + t.exercises.length, 0);
  const doneGrammar = state.completedGrammar.length;
  document.getElementById('badge-grammar').textContent = `${doneGrammar}/${totalGrammar}`;

  // Weighted mastery percentage
  const vocabRatio = totalWords ? knownCount / totalWords : 0;
  const grammarRatio = totalGrammar ? doneGrammar / totalGrammar : 0;
  const storyRatio = STORIES.length ? completedStories / STORIES.length : 0;
  const overall = Math.round((vocabRatio * 0.4 + grammarRatio * 0.45 + storyRatio * 0.15) * 100);

  document.getElementById('overall-percent').textContent = `${overall}%`;
  document.getElementById('overall-bar').style.width = `${overall}%`;
}

/* ============================================================================
   7. TAB 1: VOCABULARY TRAINER (3D CARDS + SPEED MATCH + GLOSSARY)
   ============================================================================ */
let currentDeck = [];
let currentCardIndex = 0;
let isCardFlipped = false;
let matchTimerInterval = null;
let matchSeconds = 0;
let matchMoves = 0;
let selectedMatchCards = [];
let matchedPairCount = 0;

function initVocabTab() {
  renderVocabTopicPills();
  setVocabMode(state.vocabMode);

  document.getElementById('vocab-mode-cards').addEventListener('click', () => setVocabMode('cards'));
  document.getElementById('vocab-mode-match').addEventListener('click', () => setVocabMode('match'));
  document.getElementById('vocab-mode-list').addEventListener('click', () => setVocabMode('list'));

  // Flashcard interactions
  document.getElementById('flashcard-wrapper').addEventListener('click', flipCard);
  document.getElementById('prev-card-btn').addEventListener('click', () => navigateCard(-1));
  document.getElementById('next-card-btn').addEventListener('click', () => navigateCard(1));
  document.getElementById('shuffle-cards-btn').addEventListener('click', () => {
    currentDeck = shuffleArray([...currentDeck]);
    currentCardIndex = 0;
    renderCurrentCard();
  });
  document.getElementById('unlearned-only-toggle').addEventListener('change', rebuildDeck);

  document.getElementById('mark-known-btn').addEventListener('click', () => {
    const card = currentDeck[currentCardIndex];
    if (!card) return;
    if (!state.knownWords.includes(card.id)) {
      state.knownWords.push(card.id);
      saveState();
    }
    renderVocabTopicPills();
    if (document.getElementById('unlearned-only-toggle').checked) {
      rebuildDeck();
    } else {
      navigateCard(1);
    }
  });

  document.getElementById('mark-learning-btn').addEventListener('click', () => {
    const card = currentDeck[currentCardIndex];
    if (!card) return;
    state.knownWords = state.knownWords.filter(id => id !== card.id);
    saveState();
    renderVocabTopicPills();
    navigateCard(1);
  });

  // Keyboard shortcuts for flashcards
  document.addEventListener('keydown', (e) => {
    if (state.activeTab !== 'vocab' || state.vocabMode !== 'cards') return;
    if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;
    if (e.code === 'Space') { e.preventDefault(); flipCard(); }
    if (e.code === 'ArrowRight') navigateCard(1);
    if (e.code === 'ArrowLeft') navigateCard(-1);
  });

  // Matching game buttons
  document.getElementById('restart-match-btn').addEventListener('click', startMatchingGame);
  document.getElementById('play-again-match-btn').addEventListener('click', startMatchingGame);

  // Glossary search
  document.getElementById('vocab-search-input').addEventListener('input', renderGlossaryTable);
}

function renderVocabTopicPills() {
  const container = document.getElementById('vocab-topic-pills');
  const allTopics = [{ id: 'all', title: `All Topics (${VOCAB_ITEMS.length})`, day: 'All' }, ...VOCAB_TOPICS];

  container.innerHTML = allTopics.map(t => {
    const isActive = state.vocabTopic === t.id;
    const topicItems = t.id === 'all' ? VOCAB_ITEMS : VOCAB_ITEMS.filter(i => i.topic === t.id);
    const learned = topicItems.filter(i => state.knownWords.includes(i.id)).length;
    const countText = t.id === 'all' ? `${learned}/${topicItems.length}` : `${learned}/${topicItems.length}`;

    return `
      <button data-vtopic="${t.id}" class="vtopic-pill px-3 py-1.5 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 ${
        isActive
          ? 'bg-indigo-600 text-white shadow-sm'
          : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'
      }">
        <span>${t.title}</span>
        <span class="text-[10px] px-1.5 py-0.2 rounded-full ${isActive ? 'bg-white/20 text-white' : 'bg-slate-200 dark:bg-slate-700 text-slate-500 dark:text-slate-400'}">${countText}</span>
      </button>
    `;
  }).join('');

  container.querySelectorAll('.vtopic-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      state.vocabTopic = btn.dataset.vtopic;
      saveState();
      renderVocabTopicPills();
      rebuildDeck();
      if (state.vocabMode === 'match') startMatchingGame();
      if (state.vocabMode === 'list') renderGlossaryTable();
    });
  });
}

function setVocabMode(mode) {
  state.vocabMode = mode;
  saveState();

  ['cards', 'match', 'list'].forEach(m => {
    const btn = document.getElementById(`vocab-mode-${m}`);
    const view = document.getElementById(`vocab-${m}-view`);
    const active = m === mode;
    btn.className = active
      ? 'px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-sm transition'
      : 'px-3.5 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition';
    view.classList.toggle('hidden', !active);
  });

  if (mode === 'cards') rebuildDeck();
  if (mode === 'match') startMatchingGame();
  if (mode === 'list') renderGlossaryTable();
}

function getFilteredVocab() {
  return state.vocabTopic === 'all'
    ? [...VOCAB_ITEMS]
    : VOCAB_ITEMS.filter(item => item.topic === state.vocabTopic);
}

function rebuildDeck() {
  let items = getFilteredVocab();
  const unlearnedOnly = document.getElementById('unlearned-only-toggle').checked;
  if (unlearnedOnly) {
    items = items.filter(i => !state.knownWords.includes(i.id));
  }
  currentDeck = items;
  currentCardIndex = 0;
  renderCurrentCard();
}

function renderCurrentCard() {
  const allInTopic = getFilteredVocab();
  const learnedInTopic = allInTopic.filter(i => state.knownWords.includes(i.id)).length;
  document.getElementById('topic-mastery-label').textContent = `${learnedInTopic} / ${allInTopic.length} learned`;

  // Reset flip state smoothly
  isCardFlipped = false;
  document.getElementById('flashcard-inner').classList.remove('rotate-y-180');

  if (currentDeck.length === 0) {
    document.getElementById('card-counter').textContent = '0 of 0';
    document.getElementById('card-front-topic').textContent = 'Complete!';
    document.getElementById('card-front-word').textContent = '🎉 All cards in this filter learned!';
    document.getElementById('card-front-example').textContent = 'Uncheck "Unlearned only" or choose another topic to keep practicing.';
    document.getElementById('card-back-ru').textContent = 'Отличная работа!';
    document.getElementById('card-back-def').textContent = 'You have mastered all words in this selection.';
    return;
  }

  const card = currentDeck[currentCardIndex];
  const topicObj = VOCAB_TOPICS.find(t => t.id === card.topic);
  const isKnown = state.knownWords.includes(card.id);

  document.getElementById('card-counter').textContent = `Card ${currentCardIndex + 1} of ${currentDeck.length}`;
  document.getElementById('card-front-topic').textContent = topicObj ? topicObj.title : 'Vocabulary';
  document.getElementById('card-back-day').textContent = topicObj ? topicObj.day : '';
  document.getElementById('card-front-word').textContent = card.en;
  document.getElementById('card-front-example').textContent = `"${card.ex}"`;
  document.getElementById('card-back-ru').textContent = card.ru;
  document.getElementById('card-back-def').textContent = card.def;

  const statusPill = document.getElementById('card-status-pill');
  if (isKnown) {
    statusPill.textContent = '✅ Mastered';
    statusPill.className = 'text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300';
  } else {
    statusPill.textContent = '🔄 Still Learning';
    statusPill.className = 'text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300';
  }
}

function flipCard() {
  if (currentDeck.length === 0) return;
  isCardFlipped = !isCardFlipped;
  document.getElementById('flashcard-inner').classList.toggle('rotate-y-180', isCardFlipped);
}

function navigateCard(delta) {
  if (currentDeck.length === 0) return;
  currentCardIndex = (currentCardIndex + delta + currentDeck.length) % currentDeck.length;
  renderCurrentCard();
}

/* --- Matching Mini-Game --- */
function startMatchingGame() {
  clearInterval(matchTimerInterval);
  matchSeconds = 0;
  matchMoves = 0;
  matchedPairCount = 0;
  selectedMatchCards = [];

  document.getElementById('match-moves').textContent = '0';
  document.getElementById('match-timer').textContent = '0s';
  document.getElementById('match-victory').classList.add('hidden');

  const pool = shuffleArray(getFilteredVocab()).slice(0, 6);
  const tiles = [];
  pool.forEach(item => {
    tiles.push({ pairId: item.id, type: 'en', text: item.en });
    tiles.push({ pairId: item.id, type: 'ru', text: item.ru });
  });

  const shuffledTiles = shuffleArray(tiles);
  const grid = document.getElementById('match-grid');
  grid.innerHTML = shuffledTiles.map((tile, idx) => `
    <button data-idx="${idx}" data-pair="${tile.pairId}" data-type="${tile.type}"
      class="match-tile min-h-[84px] p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 hover:border-indigo-400 text-xs sm:text-sm font-semibold text-center flex items-center justify-center transition select-none">
      ${tile.text}
    </button>
  `).join('');

  matchTimerInterval = setInterval(() => {
    matchSeconds++;
    document.getElementById('match-timer').textContent = `${matchSeconds}s`;
  }, 1000);

  grid.querySelectorAll('.match-tile').forEach(btn => {
    btn.addEventListener('click', () => handleMatchTileClick(btn, pool.length));
  });
}

function handleMatchTileClick(btn, totalPairs) {
  if (btn.disabled || selectedMatchCards.includes(btn) || selectedMatchCards.length >= 2) return;

  btn.classList.add('border-indigo-600', 'bg-indigo-50', 'dark:bg-indigo-950/60', 'text-indigo-700', 'dark:text-indigo-200');
  selectedMatchCards.push(btn);

  if (selectedMatchCards.length === 2) {
    matchMoves++;
    document.getElementById('match-moves').textContent = matchMoves;
    const [first, second] = selectedMatchCards;

    if (first.dataset.pair === second.dataset.pair && first.dataset.type !== second.dataset.type) {
      // Match!
      setTimeout(() => {
        [first, second].forEach(el => {
          el.disabled = true;
          el.classList.remove('border-indigo-600', 'bg-indigo-50', 'dark:bg-indigo-950/60');
          el.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/50', 'text-emerald-700', 'dark:text-emerald-300', 'opacity-65');
        });
        selectedMatchCards = [];
        matchedPairCount++;
        if (matchedPairCount === totalPairs) {
          clearInterval(matchTimerInterval);
          document.getElementById('match-victory-stats').textContent = `You matched all ${totalPairs} pairs in ${matchSeconds} seconds and ${matchMoves} moves!`;
          document.getElementById('match-victory').classList.remove('hidden');
        }
      }, 220);
    } else {
      // Mismatch
      setTimeout(() => {
        [first, second].forEach(el => {
          el.classList.add('border-rose-500', 'bg-rose-50', 'dark:bg-rose-950/50');
        });
      }, 150);
      setTimeout(() => {
        [first, second].forEach(el => {
          el.classList.remove('border-indigo-600', 'bg-indigo-50', 'dark:bg-indigo-950/60', 'text-indigo-700', 'dark:text-indigo-200', 'border-rose-500', 'bg-rose-50', 'dark:bg-rose-950/50');
        });
        selectedMatchCards = [];
      }, 650);
    }
  }
}

/* --- Full Glossary List --- */
function renderGlossaryTable() {
  const query = document.getElementById('vocab-search-input').value.trim().toLowerCase();
  const items = getFilteredVocab().filter(i =>
    !query || i.en.toLowerCase().includes(query) || i.ru.toLowerCase().includes(query) || i.def.toLowerCase().includes(query)
  );

  const container = document.getElementById('vocab-table-container');
  if (items.length === 0) {
    container.innerHTML = `<p class="py-8 text-center text-sm text-slate-400">No matching terms found.</p>`;
    return;
  }

  container.innerHTML = items.map(item => {
    const isKnown = state.knownWords.includes(item.id);
    return `
      <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="font-bold text-slate-900 dark:text-white">${item.en}</span>
            <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">— ${item.ru}</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">${item.def} • <span class="italic">"${item.ex}"</span></p>
        </div>
        <button data-toggle-known="${item.id}" class="self-start sm:self-center shrink-0 px-3 py-1 rounded-xl text-xs font-semibold border transition ${
          isKnown
            ? 'bg-emerald-50 dark:bg-emerald-950/50 border-emerald-300 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300'
            : 'bg-slate-50 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-500 hover:text-slate-800'
        }">
          ${isKnown ? '✅ Known' : 'Mark Known'}
        </button>
      </div>
    `;
  }).join('');

  container.querySelectorAll('[data-toggle-known]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.toggleKnown;
      if (state.knownWords.includes(id)) {
        state.knownWords = state.knownWords.filter(w => w !== id);
      } else {
        state.knownWords.push(id);
      }
      saveState();
      renderVocabTopicPills();
      renderGlossaryTable();
    });
  });
}

/* ============================================================================
   8. TAB 2: VOCABULARY QUIZZES & TESTS
   ============================================================================ */
let quizSessionQuestions = [];
let quizCurrentIdx = 0;
let quizAnswered = false;

function initQuizTab() {
  const select = document.getElementById('quiz-topic-select');
  select.innerHTML = `<option value="all">All Topics (Comprehensive Exam)</option>` +
    VOCAB_TOPICS.map(t => `<option value="${t.id}">${t.title}</option>`).join('');
  select.value = state.quizTopic;

  select.addEventListener('change', () => {
    state.quizTopic = select.value;
    saveState();
    buildQuizSession();
  });

  document.querySelectorAll('.quiz-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      state.quizMode = btn.dataset.qmode;
      saveState();
      updateQuizModeButtons();
      buildQuizSession();
    });
  });

  document.getElementById('new-quiz-set-btn').addEventListener('click', buildQuizSession);
  document.getElementById('next-quiz-btn').addEventListener('click', () => {
    quizCurrentIdx = (quizCurrentIdx + 1) % quizSessionQuestions.length;
    renderQuizQuestion();
  });

  updateQuizModeButtons();
  buildQuizSession();
}

function updateQuizModeButtons() {
  document.querySelectorAll('.quiz-mode-btn').forEach(btn => {
    const active = btn.dataset.qmode === state.quizMode;
    btn.className = active
      ? 'quiz-mode-btn p-4 rounded-2xl border-2 border-indigo-600 bg-indigo-50/70 dark:bg-indigo-950/40 text-left transition'
      : 'quiz-mode-btn p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-indigo-400 text-left transition';
  });
}

function buildQuizSession() {
  let pool = QUIZ_BANK.filter(q => q.mode === state.quizMode);
  if (state.quizMode !== 'usuk' && state.quizTopic !== 'all') {
    const topicFiltered = pool.filter(q => q.topic === state.quizTopic);
    if (topicFiltered.length > 0) {
      pool = topicFiltered;
    } else {
      // Dynamically generate questions from VOCAB_ITEMS for any topic!
      const vocabPool = VOCAB_ITEMS.filter(v => v.topic === state.quizTopic);
      pool = vocabPool.map(v => {
        const distractors = shuffleArray(VOCAB_ITEMS.filter(x => x.id !== v.id)).slice(0, 3).map(d => d.en);
        return {
          mode: state.quizMode,
          topic: v.topic,
          prompt: state.quizMode === 'definition'
            ? `Definition: "${v.def}" (${v.ru})`
            : `Complete the sentence: "${v.ex.replace(new RegExp(escapeRegExp(v.en.split(' ')[0]), 'i'), '____')}"`,
          answer: v.en,
          options: shuffleArray([v.en, ...distractors]),
          exp: `${v.en} (${v.ru}) — ${v.def}`
        };
      });
    }
  }

  quizSessionQuestions = shuffleArray(pool).slice(0, 10);
  quizCurrentIdx = 0;
  renderQuizQuestion();
}

function renderQuizQuestion() {
  quizAnswered = false;
  const q = quizSessionQuestions[quizCurrentIdx];
  if (!q) return;

  const topicObj = VOCAB_TOPICS.find(t => t.id === q.topic);
  document.getElementById('quiz-progress-label').textContent = `Question ${quizCurrentIdx + 1} of ${quizSessionQuestions.length}`;
  document.getElementById('quiz-streak-label').textContent = `🔥 Streak: ${state.quizStreak}`;
  document.getElementById('quiz-category-badge').textContent = topicObj ? topicObj.title : 'Level Two Lexis';
  document.getElementById('quiz-prompt').textContent = q.prompt;

  const feedback = document.getElementById('quiz-feedback');
  feedback.classList.add('hidden');
  document.getElementById('next-quiz-btn').classList.add('hidden');

  const optsContainer = document.getElementById('quiz-options');
  const shuffledOpts = shuffleArray([...q.options]);

  optsContainer.innerHTML = shuffledOpts.map(opt => `
    <button data-opt="${escapeHtml(opt)}" class="quiz-opt-btn p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-indigo-500 bg-slate-50/70 dark:bg-slate-800/60 text-left font-semibold text-sm transition">
      ${opt}
    </button>
  `).join('');

  optsContainer.querySelectorAll('.quiz-opt-btn').forEach(btn => {
    btn.addEventListener('click', () => handleQuizAnswer(btn, q));
  });
}

function handleQuizAnswer(selectedBtn, question) {
  if (quizAnswered) return;
  quizAnswered = true;

  const chosen = selectedBtn.dataset.opt;
  const isCorrect = chosen === question.answer;

  document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
    btn.disabled = true;
    if (btn.dataset.opt === question.answer) {
      btn.classList.remove('border-slate-200', 'dark:border-slate-700');
      btn.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/60', 'text-emerald-700', 'dark:text-emerald-300');
    } else if (btn === selectedBtn && !isCorrect) {
      btn.classList.remove('border-slate-200', 'dark:border-slate-700');
      btn.classList.add('border-rose-500', 'bg-rose-50', 'dark:bg-rose-950/60', 'text-rose-700', 'dark:text-rose-300');
    }
  });

  const feedback = document.getElementById('quiz-feedback');
  feedback.classList.remove('hidden');

  if (isCorrect) {
    state.quizScore += 10;
    state.quizStreak += 1;
    feedback.className = 'p-4 rounded-2xl text-sm bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200';
    feedback.innerHTML = `<strong>✅ Spot on! (+10 pts)</strong> ${question.exp}`;
  } else {
    state.quizStreak = 0;
    feedback.className = 'p-4 rounded-2xl text-sm bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200';
    feedback.innerHTML = `<strong>❌ Not quite!</strong> Correct answer: <strong>${question.answer}</strong>. ${question.exp}`;
  }

  document.getElementById('quiz-streak-label').textContent = `🔥 Streak: ${state.quizStreak}`;
  document.getElementById('next-quiz-btn').classList.remove('hidden');
  saveState();
}

/* ============================================================================
   9. TAB 3: READING STORIES & COMPREHENSION
   ============================================================================ */
function initStoriesTab() {
  renderStorySelector();
  loadStory(state.activeStoryId);

  document.getElementById('check-story-btn').addEventListener('click', checkStoryAnswers);
}

function renderStorySelector() {
  const bar = document.getElementById('story-selector-bar');
  bar.innerHTML = STORIES.map((s, idx) => {
    const isActive = s.id === state.activeStoryId;
    const score = state.storyScores[s.id];
    return `
      <button data-story="${s.id}" class="story-select-btn p-4 rounded-2xl border-2 text-left transition ${
        isActive
          ? 'border-indigo-600 bg-indigo-50/70 dark:bg-indigo-950/40 shadow-sm'
          : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-indigo-400'
      }">
        <div class="flex items-center justify-between text-xs font-bold text-indigo-600 dark:text-indigo-400">
          <span>Story ${idx + 1}</span>
          <span>${score !== undefined ? `✅ ${score}/${s.questions.length}` : 'Unread'}</span>
        </div>
        <div class="font-bold text-sm mt-1 line-clamp-1">${s.title}</div>
      </button>
    `;
  }).join('');

  bar.querySelectorAll('.story-select-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      state.activeStoryId = btn.dataset.story;
      saveState();
      renderStorySelector();
      loadStory(state.activeStoryId);
    });
  });
}

function loadStory(storyId) {
  const story = STORIES.find(s => s.id === storyId) || STORIES[0];
  document.getElementById('story-meta-tags').textContent = story.tags;
  document.getElementById('story-title').textContent = story.title;

  const body = document.getElementById('story-body');
  body.innerHTML = story.paragraphs.map(p => `<p>${p}</p>`).join('');

  // Attach interactive glossary popups to highlighted terms
  body.querySelectorAll('.story-term').forEach(span => {
    span.addEventListener('click', () => {
      const key = span.dataset.word;
      const entry = story.glossary[key];
      if (!entry) return;
      document.getElementById('popover-topic').textContent = 'Story Vocabulary & Grammar';
      document.getElementById('popover-word').textContent = span.textContent;
      document.getElementById('popover-ru').textContent = entry.ru;
      document.getElementById('popover-def').textContent = entry.def;
      document.getElementById('word-popover').classList.remove('hidden');
    });
  });

  // Render comprehension questions
  const qList = document.getElementById('story-questions-list');
  qList.innerHTML = story.questions.map((item, qIdx) => `
    <div class="story-q-block space-y-2" data-qidx="${qIdx}">
      <p class="text-sm font-bold">${qIdx + 1}. ${item.q}</p>
      <div class="space-y-1.5">
        ${item.opts.map((opt, oIdx) => `
          <label class="flex items-start gap-2.5 p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer text-xs sm:text-sm transition">
            <input type="radio" name="story_q_${qIdx}" value="${oIdx}" class="mt-0.5 text-indigo-600 focus:ring-indigo-500" />
            <span>${opt}</span>
          </label>
        `).join('')}
      </div>
      <div class="story-q-feedback hidden text-xs font-semibold px-3 py-1.5 rounded-lg"></div>
    </div>
  `).join('');

  const prevScore = state.storyScores[story.id];
  document.getElementById('story-score-badge').textContent = `${prevScore !== undefined ? prevScore : 0} / ${story.questions.length}`;
}

function checkStoryAnswers() {
  const story = STORIES.find(s => s.id === state.activeStoryId) || STORIES[0];
  let correctCount = 0;

  story.questions.forEach((item, qIdx) => {
    const selected = document.querySelector(`input[name="story_q_${qIdx}"]:checked`);
    const block = document.querySelector(`.story-q-block[data-qidx="${qIdx}"]`);
    const fb = block.querySelector('.story-q-feedback');
    fb.classList.remove('hidden');

    if (selected && parseInt(selected.value, 10) === item.ans) {
      correctCount++;
      fb.className = 'story-q-feedback text-xs font-semibold px-3 py-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300';
      fb.textContent = '✅ Correct!';
    } else {
      fb.className = 'story-q-feedback text-xs font-semibold px-3 py-1.5 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300';
      fb.textContent = `❌ Correct answer: ${item.opts[item.ans]}`;
    }
  });

  state.storyScores[story.id] = correctCount;
  saveState();
  document.getElementById('story-score-badge').textContent = `${correctCount} / ${story.questions.length}`;
  renderStorySelector();
}

/* ============================================================================
   10. TAB 4: GRAMMAR LAB (14 SUB-TOPICS, 10 EXERCISES EACH = 140 EXERCISES)
   ============================================================================ */
let puzzleSelections = {}; // { exerciseId: [wordIndices] }

function initGrammarTab() {
  renderGrammarSubtabs();
  loadGrammarTopic(state.activeGrammarId);
}

function renderGrammarSubtabs() {
  const list = document.getElementById('grammar-subtabs-list');
  list.innerHTML = GRAMMAR_TOPICS.map(topic => {
    const isActive = topic.id === state.activeGrammarId;
    const doneCount = topic.exercises.filter(ex => state.completedGrammar.includes(ex.id)).length;
    const isComplete = doneCount === topic.exercises.length;

    return `
      <button data-gtopic="${topic.id}" class="gtopic-btn w-full flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl text-left text-xs font-semibold transition ${
        isActive
          ? 'bg-indigo-600 text-white shadow-sm'
          : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300'
      }">
        <span class="truncate">${topic.title}</span>
        <span class="shrink-0 px-2 py-0.5 rounded-full text-[10px] font-bold ${
          isActive
            ? 'bg-white/20 text-white'
            : isComplete
              ? 'bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300'
              : 'bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400'
        }">${doneCount}/10</span>
      </button>
    `;
  }).join('');

  list.querySelectorAll('.gtopic-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      state.activeGrammarId = btn.dataset.gtopic;
      saveState();
      renderGrammarSubtabs();
      loadGrammarTopic(state.activeGrammarId);
    });
  });
}

function loadGrammarTopic(topicId) {
  const topic = GRAMMAR_TOPICS.find(t => t.id === topicId) || GRAMMAR_TOPICS[0];
  const doneCount = topic.exercises.filter(ex => state.completedGrammar.includes(ex.id)).length;

  document.getElementById('grammar-day-badge').textContent = topic.day;
  document.getElementById('grammar-topic-progress').textContent = `${doneCount} / ${topic.exercises.length} Completed`;
  document.getElementById('grammar-topic-title').textContent = topic.title;
  document.getElementById('grammar-rule-desc').textContent = topic.desc;
  document.getElementById('grammar-formulas').innerHTML = topic.formulas.map(f => `<div>• ${f}</div>`).join('');

  const container = document.getElementById('grammar-exercises-container');
  container.innerHTML = topic.exercises.map((ex, idx) => {
    const isSolved = state.completedGrammar.includes(ex.id);
    let bodyHtml = '';

    if (ex.type === 'puzzle') {
      // Shuffle initial bank deterministically per load
      const bankWords = shuffleArray(ex.words.map((w, i) => ({ word: w, origIdx: i })));
      puzzleSelections[ex.id] = { bank: bankWords, chosen: [] };

      bodyHtml = `
        <div class="space-y-3">
          <div id="puzzle-answer-${ex.id}" class="min-h-[48px] p-3 rounded-2xl border-2 border-dashed border-indigo-300 dark:border-indigo-700 bg-indigo-50/40 dark:bg-indigo-950/20 flex flex-wrap gap-1.5 items-center">
            <span class="text-xs text-slate-400 italic">Click word tiles below to build the sentence...</span>
          </div>
          <div id="puzzle-bank-${ex.id}" class="flex flex-wrap gap-1.5">
            ${bankWords.map((item, bIdx) => `
              <button type="button" data-ex="${ex.id}" data-bidx="${bIdx}" class="puzzle-tile px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:border-indigo-500 text-xs sm:text-sm font-semibold shadow-sm transition">
                ${item.word}
              </button>
            `).join('')}
          </div>
          <div class="flex items-center gap-2 pt-1">
            <button type="button" data-check-puzzle="${ex.id}" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition">Check Sentence</button>
            <button type="button" data-clear-puzzle="${ex.id}" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-xs font-semibold transition">Clear</button>
          </div>
        </div>
      `;
    } else if (ex.type === 'fill') {
      bodyHtml = `
        <div class="flex flex-col sm:flex-row gap-2">
          <input type="text" id="fill-input-${ex.id}" placeholder="Type the missing word(s)..." class="flex-1 px-3.5 py-2.5 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          <button type="button" data-check-fill="${ex.id}" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition">Check</button>
        </div>
      `;
    } else if (ex.type === 'mc') {
      const opts = shuffleArray([...ex.opts]);
      bodyHtml = `
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          ${opts.map(opt => `
            <button type="button" data-check-mc="${ex.id}" data-val="${escapeHtml(opt)}" class="g-mc-btn p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-indigo-500 bg-slate-50 dark:bg-slate-800/70 text-left text-xs sm:text-sm font-medium transition">
              ${opt}
            </button>
          `).join('')}
        </div>
      `;
    }

    return `
      <div id="ex-card-${ex.id}" class="bg-white dark:bg-slate-900 rounded-2xl p-5 border ${isSolved ? 'border-emerald-300 dark:border-emerald-800' : 'border-slate-200 dark:border-slate-800'} shadow-sm space-y-3">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Task ${idx + 1} of 10 • ${ex.type === 'puzzle' ? 'Sentence Puzzle' : ex.type === 'fill' ? 'Fill in the Form' : 'Multiple Choice'}</span>
          <span id="ex-status-${ex.id}" class="text-xs font-bold ${isSolved ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-400'}">${isSolved ? '✅ Completed' : 'Unsolved'}</span>
        </div>
        <p class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">${ex.prompt}</p>
        ${bodyHtml}
        <div id="ex-feedback-${ex.id}" class="hidden p-3 rounded-xl text-xs"></div>
      </div>
    `;
  }).join('');

  attachGrammarExerciseListeners(topic);
}

function attachGrammarExerciseListeners(topic) {
  const container = document.getElementById('grammar-exercises-container');

  // Puzzle tile clicks
  container.querySelectorAll('.puzzle-tile').forEach(btn => {
    btn.addEventListener('click', () => {
      const exId = btn.dataset.ex;
      const bIdx = parseInt(btn.dataset.bidx, 10);
      const pState = puzzleSelections[exId];
      if (!pState.chosen.includes(bIdx)) {
        pState.chosen.push(bIdx);
        btn.classList.add('opacity-30', 'pointer-events-none');
        renderPuzzleAnswerBox(exId);
      }
    });
  });

  // Clear puzzle
  container.querySelectorAll('[data-clear-puzzle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const exId = btn.dataset.clearPuzzle;
      puzzleSelections[exId].chosen = [];
      container.querySelectorAll(`.puzzle-tile[data-ex="${exId}"]`).forEach(t => {
        t.classList.remove('opacity-30', 'pointer-events-none');
      });
      renderPuzzleAnswerBox(exId);
    });
  });

  // Check puzzle
  container.querySelectorAll('[data-check-puzzle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const exId = btn.dataset.checkPuzzle;
      const ex = topic.exercises.find(e => e.id === exId);
      const pState = puzzleSelections[exId];
      const userSentence = pState.chosen.map(i => pState.bank[i].word).join(' ');
      const isCorrect = normalizeText(userSentence) === normalizeText(ex.answer);
      showGrammarResult(topic, ex, isCorrect, ex.answer);
    });
  });

  // Check fill-in-the-blank
  container.querySelectorAll('[data-check-fill]').forEach(btn => {
    btn.addEventListener('click', () => {
      const exId = btn.dataset.checkFill;
      const ex = topic.exercises.find(e => e.id === exId);
      const inputVal = document.getElementById(`fill-input-${exId}`).value;
      const validAnswers = [ex.answer, ...(ex.alt || [])].map(normalizeText);
      const isCorrect = validAnswers.includes(normalizeText(inputVal));
      showGrammarResult(topic, ex, isCorrect, ex.answer);
    });
  });

  // Check multiple choice
  container.querySelectorAll('[data-check-mc]').forEach(btn => {
    btn.addEventListener('click', () => {
      const exId = btn.dataset.checkMc;
      const ex = topic.exercises.find(e => e.id === exId);
      const isCorrect = btn.dataset.val === ex.answer;
      showGrammarResult(topic, ex, isCorrect, ex.answer);
    });
  });
}

function renderPuzzleAnswerBox(exId) {
  const pState = puzzleSelections[exId];
  const box = document.getElementById(`puzzle-answer-${exId}`);
  if (pState.chosen.length === 0) {
    box.innerHTML = `<span class="text-xs text-slate-400 italic">Click word tiles below to build the sentence...</span>`;
    return;
  }

  box.innerHTML = pState.chosen.map((bIdx, pos) => `
    <button type="button" data-remove-pos="${pos}" class="px-3 py-1.5 rounded-xl bg-indigo-600 text-white text-xs sm:text-sm font-semibold shadow-sm hover:bg-rose-600 transition" title="Click to remove">
      ${pState.bank[bIdx].word}
    </button>
  `).join('');

  box.querySelectorAll('[data-remove-pos]').forEach(chip => {
    chip.addEventListener('click', () => {
      const pos = parseInt(chip.dataset.removePos, 10);
      const removedBankIdx = pState.chosen.splice(pos, 1)[0];
      const bankBtn = document.querySelector(`.puzzle-tile[data-ex="${exId}"][data-bidx="${removedBankIdx}"]`);
      if (bankBtn) bankBtn.classList.remove('opacity-30', 'pointer-events-none');
      renderPuzzleAnswerBox(exId);
    });
  });
}

function showGrammarResult(topic, ex, isCorrect, expectedAnswer) {
  const fb = document.getElementById(`ex-feedback-${ex.id}`);
  fb.classList.remove('hidden');

  if (isCorrect) {
    fb.className = 'p-3 rounded-xl text-xs bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200';
    fb.innerHTML = `<strong>✅ Correct!</strong> ${ex.exp}`;

    if (!state.completedGrammar.includes(ex.id)) {
      state.completedGrammar.push(ex.id);
      saveState();
    }
    document.getElementById(`ex-status-${ex.id}`).textContent = '✅ Completed';
    document.getElementById(`ex-status-${ex.id}`).className = 'text-xs font-bold text-emerald-600 dark:text-emerald-400';
    document.getElementById(`ex-card-${ex.id}`).classList.add('border-emerald-300', 'dark:border-emerald-800');

    const doneCount = topic.exercises.filter(e => state.completedGrammar.includes(e.id)).length;
    document.getElementById('grammar-topic-progress').textContent = `${doneCount} / ${topic.exercises.length} Completed`;
    renderGrammarSubtabs();
  } else {
    fb.className = 'p-3 rounded-xl text-xs bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200';
    fb.innerHTML = `<strong>❌ Try again!</strong> Expected: <em>"${expectedAnswer}"</em>. ${ex.exp}`;
  }
}

/* ============================================================================
   11. UTILITY HELPERS
   ============================================================================ */
function shuffleArray(arr) {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

function normalizeText(str) {
  return String(str || '')
    .toLowerCase()
    .replace(/[’']/g, "'")
    .replace(/[.,!?;:"]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function escapeHtml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function escapeRegExp(str) {
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}
